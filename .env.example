# ========================================================
# OshxonaPOS Environment Configuration
# ========================================================

# Server Port
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oshxona_pos?schema=public"

# JWT Secrets
JWT_ACCESS_SECRET="oshxona-pos-access-secret-key-32chars-min-change-in-prod"
JWT_REFRESH_SECRET="oshxona-pos-refresh-secret-key-32chars-min-change-in-prod"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Device Configuration
DEFAULT_DEVICE_ID="kassa-pos-master-01"
DEFAULT_BRANCH_ID="branch-main-01"

# Cloud Sync Configuration (Local server -> Cloud)
CLOUD_API_URL="https://cloud.oshxonapos.uz"
CLOUD_SYNC_API_KEY="sync-secret-auth-key-change-in-prod"
SYNC_INTERVAL_MS=15000
