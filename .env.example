# ========================================================
# OshxonaPOS — Lokal server (apps/local-server) va Prisma (packages/db)
# Nusxa oling: cp .env.example .env   (.env gitignore qilingan — HECH QACHON commit qilmang)
# apps/local-server/.env va packages/db/.env shu faylga symlink bo'lishi mumkin:
#   ln -s ../../.env apps/local-server/.env && ln -s ../../.env packages/db/.env
# ========================================================

NODE_ENV=development
# Lokal server porti va interfeysi (0.0.0.0 — LAN dagi kassa/KDS qurilmalari ulanishi uchun)
PORT=4000
HOST=0.0.0.0

# PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/oshxona_pos?schema=public"

# JWT kalitlari — MAJBURIY, kamida 32 belgi, ikkalasi har xil. Yaratish:  openssl rand -hex 48
# O'rnatilmagan yoki namunaviy bo'lsa server ishga tushmaydi.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# CORS — brauzer originlari (vergul bilan, aniq moslik). Admin web (3000) va POS (5173):
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,oshxona://pos"
# Lokal tarmoq (192.168.x.x, 10.x.x.x, 172.16-31.x.x) originlariga ruxsat — LAN kassalari/KDS uchun
CORS_ALLOW_PRIVATE_LAN=true
# Electron (file://) "null" origin yuboradi. Faqat paketlangan Electron kassa ishlatilsa true qiling.
CORS_ALLOW_NULL_ORIGIN=false
# Production'da Swagger (/api/docs) o'chiq. Yoqish uchun: true
ENABLE_SWAGGER=false

# Qurilma
DEFAULT_DEVICE_ID="kassa-pos-01"

# Bulut sinxronizatsiyasi (lokal server -> cloud-api)
CLOUD_API_URL=""
CLOUD_SYNC_API_KEY=""
SYNC_INTERVAL_MS=15000

# Seed: bazada ma'lumot bo'lsa seed ishlamaydi. Faqat backup olgandan keyin, DEV bazada:
# SEED_ALLOW_RESET=true
