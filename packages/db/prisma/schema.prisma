generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------
// ENUMS
// --------------------------------------------------------

enum Role {
  ADMIN
  CASHIER
  WAITER
}

enum DeviceType {
  POS_CASHIER
  KDS_KITCHEN
  WAITER_TABLET
  ADMIN_STATION
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  OPEN
  SENT
  PAID
  CANCELLED
  REFUNDED
}

enum OrderItemStatus {
  PENDING
  COOKING
  READY
  SERVED
  CANCELLED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  PAYMENT_PENDING
  RESERVED
}

enum PaymentMethod {
  CASH
  CARD
  CLICK
  PAYME
  DEBT
}

enum ReceiptType {
  SALE
  KITCHEN
  COPY
  X_REPORT
  Z_REPORT
}

enum StockMovementType {
  IN
  OUT_SALE
  WASTE
  ADJUST
  RETURN
}

enum CashMovementType {
  DEPOSIT
  WITHDRAWAL
  EXPENSE
}

enum UnitType {
  PORTION
  KG
  GRAM
  LITRE
  ML
  PIECE
}

enum PrinterType {
  USB
  LAN
  BLUETOOTH
}

enum SyncOperation {
  CREATE
  UPDATE
  DELETE
}

enum SyncStatus {
  PENDING
  PROCESSING
  SYNCED
  FAILED
}

// --------------------------------------------------------
// MODELS
// --------------------------------------------------------

model Branch {
  id          String    @id
  name        String
  address     String?
  phone       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  version     Int       @default(1)
  syncedAt    DateTime?
  deviceId    String?

  users       User[]
  devices     Device[]
  halls       Hall[]
  orders      Order[]
  shifts      Shift[]
  printers    Printer[]

  @@map("branches")
}

model User {
  id            String    @id
  name          String
  username      String    @unique
  role          Role      @default(CASHIER)
  pinHash       String
  passwordHash  String?
  discountLimit Int       @default(10) // maksimal chegirma foizi (masalan 10%)
  isActive      Boolean   @default(true)
  branchId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  version       Int       @default(1)
  syncedAt      DateTime?
  deviceId      String?

  branch        Branch?   @relation(fields: [branchId], references: [id])
  ordersCashier Order[]   @relation("OrderCashier")
  ordersWaiter  Order[]   @relation("OrderWaiter")
  shifts        Shift[]
  auditLogs     AuditLog[]

  @@index([branchId])
  @@map("users")
}

model Device {
  id          String      @id
  name        String
  type        DeviceType  @default(POS_CASHIER)
  lastActive  DateTime?
  branchId    String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  version     Int         @default(1)
  syncedAt    DateTime?
  deviceId    String?

  branch      Branch?     @relation(fields: [branchId], references: [id])
  orders      Order[]

  @@index([branchId])
  @@map("devices")
}

model Category {
  id          String      @id
  name        String
  nameRu      String?
  color       String?     @default("#F97316") // to'q sariq default
  icon        String?
  imageUrl    String?
  sortOrder   Int         @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  version     Int         @default(1)
  syncedAt    DateTime?
  deviceId    String?

  menuItems   MenuItem[]

  @@map("categories")
}

model MenuItem {
  id                String            @id
  name              String
  nameRu            String?
  description       String?
  imageUrl          String?
  price             Int               // sotuv narxi (so'm)
  costPrice         Int               @default(0) // tannarx (so'm)
  unit              UnitType          @default(PORTION)
  categoryId        String
  kitchenStationId  String?           // Issiq sex, Salat sex, Bar va h.k.
  isAvailable       Boolean           @default(true)
  isFeatured        Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
  version           Int               @default(1)
  syncedAt          DateTime?
  deviceId          String?

  category          Category          @relation(fields: [categoryId], references: [id])
  variants          MenuItemVariant[]
  modifierGroups    ModifierGroup[]
  orderItems        OrderItem[]
  recipes           Recipe[]
  priceHistories    PriceHistory[]

  @@index([categoryId])
  @@map("menu_items")
}

model MenuItemVariant {
  id          String      @id
  menuItemId  String
  name        String      // masalan: 0.5 porsiya / 1 porsiya / 1 kg
  price       Int
  costPrice   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  version     Int         @default(1)
  syncedAt    DateTime?
  deviceId    String?

  menuItem    MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  @@index([menuItemId])
  @@map("menu_item_variants")
}

model ModifierGroup {
  id          String      @id
  menuItemId  String
  name        String      // masalan: Qo'shimchalar, Go'sht turi
  minSelect   Int         @default(0)
  maxSelect   Int         @default(1)
  isRequired  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  version     Int         @default(1)
  syncedAt    DateTime?
  deviceId    String?

  menuItem    MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifiers   Modifier[]

  @@index([menuItemId])
  @@map("modifier_groups")
}

model Modifier {
  id          String        @id
  groupId     String
  name        String        // masalan: + qazi, + tuxum, achchiqsiz
  price       Int           @default(0) // 0 bo'lsa bepul
  costPrice   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  version     Int           @default(1)
  syncedAt    DateTime?
  deviceId    String?

  group       ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("modifiers")
}

model Ingredient {
  id          String          @id
  name        String          // masalan: Guruch (lazer), Mol go'shti, Sabzi
  unit        UnitType        @default(KG)
  minQty      Decimal         @default(0) @db.Decimal(12, 3)
  currentQty  Decimal         @default(0) @db.Decimal(12, 3)
  avgCost     Int             @default(0) // 1 birlik o'rtacha tannarxi (so'm)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  version     Int             @default(1)
  syncedAt    DateTime?
  deviceId    String?

  recipeItems RecipeItem[]
  movements   StockMovement[]

  @@map("ingredients")
}

model Recipe {
  id          String        @id
  menuItemId  String
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  version     Int           @default(1)
  syncedAt    DateTime?
  deviceId    String?

  menuItem    MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  items       RecipeItem[]

  @@index([menuItemId])
  @@map("recipes")
}

model RecipeItem {
  id            String      @id
  recipeId      String
  ingredientId  String
  quantity      Decimal     @db.Decimal(12, 3) // retseptdagi miqdor
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  version       Int         @default(1)
  syncedAt      DateTime?
  deviceId      String?

  recipe        Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient    Ingredient  @relation(fields: [ingredientId], references: [id])

  @@index([recipeId])
  @@index([ingredientId])
  @@map("recipe_items")
}

model StockMovement {
  id            String            @id
  ingredientId  String
  type          StockMovementType
  quantity      Decimal           @db.Decimal(12, 3)
  unitCost      Int               @default(0)
  totalCost     Int               @default(0)
  supplierId    String?
  reason        String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
  version       Int               @default(1)
  syncedAt      DateTime?
  deviceId      String?

  ingredient    Ingredient        @relation(fields: [ingredientId], references: [id])
  supplier      Supplier?         @relation(fields: [supplierId], references: [id])

  @@index([ingredientId, createdAt])
  @@index([supplierId])
  @@map("stock_movements")
}

model Supplier {
  id          String          @id
  name        String
  phone       String?
  address     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  version     Int             @default(1)
  syncedAt    DateTime?
  deviceId    String?

  movements   StockMovement[]

  @@map("suppliers")
}

model Hall {
  id          String    @id
  name        String    // Asosiy zal, Ayvon, VIP xona
  branchId    String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  version     Int       @default(1)
  syncedAt    DateTime?
  deviceId    String?

  branch      Branch?   @relation(fields: [branchId], references: [id])
  tables      Table[]

  @@index([branchId])
  @@map("halls")
}

model Table {
  id          String      @id
  hallId      String
  name        String      // masalan: Stol 1, Stol 12, VIP 1
  capacity    Int         @default(4)
  status      TableStatus @default(AVAILABLE)
  posX        Int         @default(0)
  posY        Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  version     Int         @default(1)
  syncedAt    DateTime?
  deviceId    String?

  hall        Hall        @relation(fields: [hallId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@index([hallId])
  @@map("tables")
}

model Order {
  id            String        @id
  orderNumber   String        // masalan K1-0425-0037
  type          OrderType     @default(DINE_IN)
  status        OrderStatus   @default(OPEN)
  branchId      String?
  tableId       String?
  cashierId     String
  waiterId      String?
  deviceId      String?
  guestCount    Int           @default(1)
  notes         String?
  subtotal      Int           @default(0) // taomlar jami
  serviceFee    Int           @default(0) // xizmat haqi
  discount      Int           @default(0) // chegirma summasi
  discountNote  String?
  total         Int           @default(0) // to'lov summasi
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  version       Int           @default(1)
  syncedAt      DateTime?

  branch        Branch?       @relation(fields: [branchId], references: [id])
  table         Table?        @relation(fields: [tableId], references: [id])
  cashier       User          @relation("OrderCashier", fields: [cashierId], references: [id])
  waiter        User?         @relation("OrderWaiter", fields: [waiterId], references: [id])
  device        Device?       @relation(fields: [deviceId], references: [id])
  items         OrderItem[]
  payments      Payment[]
  receipts      Receipt[]

  @@index([status, createdAt])
  @@index([branchId, createdAt])
  @@index([tableId])
  @@index([cashierId])
  @@index([waiterId])
  @@map("orders")
}

model OrderItem {
  id          String          @id
  orderId     String
  menuItemId  String
  variantId   String?
  name        String          // sotuv paytidagi nom
  unitPrice   Int             // sotuv paytidagi narx muzlatilgan
  costPrice   Int             @default(0) // sotuv paytidagi tannarx
  quantity    Decimal         @db.Decimal(12, 3)
  totalPrice  Int             // unitPrice * quantity
  notes       String?         // piyozsiz, achchiq va h.k.
  modifiers   Json?           // tanlangan qo'shimchalar
  status      OrderItemStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  version     Int             @default(1)
  syncedAt    DateTime?
  deviceId    String?

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem    MenuItem        @relation(fields: [menuItemId], references: [id])
  variant     MenuItemVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([menuItemId])
  @@index([status])
  @@map("order_items")
}

model Payment {
  id            String        @id
  orderId       String
  method        PaymentMethod @default(CASH)
  amount        Int           // to'langan summa
  received      Int           @default(0) // mijoz bergan naqd summa
  change        Int           @default(0) // qaytim
  transactionId String?       // Click/Payme tranzaksiya ID
  customerId    String?       // Nasiya uchun
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  version       Int           @default(1)
  syncedAt      DateTime?
  deviceId      String?

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer      Customer?     @relation(fields: [customerId], references: [id])

  @@index([orderId])
  @@index([customerId])
  @@index([createdAt])
  @@map("payments")
}

model Receipt {
  id          String        @id
  orderId     String
  receiptNo   String
  type        ReceiptType   @default(SALE)
  printedAt   DateTime      @default(now())
  printCount  Int           @default(1)
  content     String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  version     Int           @default(1)
  syncedAt    DateTime?
  deviceId    String?

  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("receipts")
}

model Shift {
  id              String          @id
  userId          String
  branchId        String?
  openedAt        DateTime        @default(now())
  closedAt        DateTime?
  startingCash    Int             @default(0)
  expectedCash    Int             @default(0)
  actualCash      Int             @default(0)
  cashDifference  Int             @default(0)
  totalSales      Int             @default(0)
  totalCash       Int             @default(0)
  totalCard       Int             @default(0)
  totalClick      Int             @default(0)
  totalPayme      Int             @default(0)
  totalDebt       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  version         Int             @default(1)
  syncedAt        DateTime?
  deviceId        String?

  user            User            @relation(fields: [userId], references: [id])
  branch          Branch?         @relation(fields: [branchId], references: [id])
  cashMovements   CashMovement[]

  @@index([userId, closedAt])
  @@index([branchId, openedAt])
  @@map("shifts")
}

model CashMovement {
  id          String            @id
  shiftId     String
  type        CashMovementType
  amount      Int
  reason      String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  version     Int               @default(1)
  syncedAt    DateTime?
  deviceId    String?

  shift       Shift             @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
  @@map("cash_movements")
}

model Customer {
  id          String            @id
  name        String
  phone       String            @unique
  debtBalance Int               @default(0) // qarzdorlik summasi
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  version     Int               @default(1)
  syncedAt    DateTime?
  deviceId    String?

  payments    Payment[]
  debts       DebtTransaction[]

  @@map("customers")
}

model DebtTransaction {
  id          String    @id
  customerId  String
  amount      Int       // musbat = qarz berildi, manfiy = qarz to'landi
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  version     Int       @default(1)
  syncedAt    DateTime?
  deviceId    String?

  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("debt_transactions")
}

model Discount {
  id          String    @id
  name        String    // masalan: Doimiy mijoz - 10%, Happy hour - 20%
  percent     Int       @default(0)
  fixedAmount Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  version     Int       @default(1)
  syncedAt    DateTime?
  deviceId    String?

  @@map("discounts")
}

model PriceHistory {
  id          String    @id
  menuItemId  String
  oldPrice    Int
  newPrice    Int
  changedBy   String
  reason      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  version     Int       @default(1)
  syncedAt    DateTime?
  deviceId    String?

  menuItem    MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@map("price_histories")
}

model Printer {
  id          String      @id
  name        String      // masalan: Kassa printeri, Oshxona issiq sex printeri
  type        PrinterType @default(LAN)
  address     String      // USB nomi, IP address (192.168.1.200) yoki MAC
  paperWidth  Int         @default(80) // 58 yoki 80 (mm)
  stationId   String?     // Issiq sex, Salat sex, Bar va h.k.
  branchId    String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  version     Int         @default(1)
  syncedAt    DateTime?
  deviceId    String?

  branch      Branch?     @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@map("printers")
}

model Setting {
  id          String    @id
  key         String    @unique
  value       String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  version     Int       @default(1)
  syncedAt    DateTime?
  deviceId    String?

  @@map("settings")
}

model AuditLog {
  id          String    @id
  userId      String?
  action      String    // LOGIN, CREATE_ORDER, CANCEL_ORDER, REFUND, REPRINT_RECEIPT
  details     Json?
  ipAddress   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  version     Int       @default(1)
  syncedAt    DateTime?
  deviceId    String?

  user        User?     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model SyncQueue {
  id          String        @id
  entity      String        // order, payment, stock_movement, menu_item
  entityId    String
  operation   SyncOperation
  payload     Json
  status      SyncStatus    @default(PENDING)
  attempts    Int           @default(0)
  lastError   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  version     Int           @default(1)
  syncedAt    DateTime?
  deviceId    String?

  @@index([status, createdAt])
  @@map("sync_queue")
}
