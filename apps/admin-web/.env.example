# Admin web / KDS / QR menyu (Next.js). Nusxa: cp .env.example .env.local
# NEXT_PUBLIC_* qiymatlari BUILD vaqtida kodga kiritiladi (o'zgartirgandan keyin qayta build qiling).
# Bo'sh qoldirilsa: brauzerda ochilgan host + NEXT_PUBLIC_API_PORT (masalan http://192.168.1.10:4000).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_PORT=4000
