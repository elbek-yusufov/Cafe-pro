# POS kassa (Vite). Nusxa: cp .env.example .env.local
# Bo'sh qoldirilsa: sahifa ochilgan host + VITE_API_PORT (masalan http://192.168.1.10:4000).
# Paketlangan Electron kassa boshqa kompyuterda bo'lsa — server kompyuterning LAN manzilini yozing.
VITE_API_URL=
VITE_API_PORT=4000
# Ushbu kassaning qurilma IDsi (devices jadvalidan)
VITE_DEVICE_ID=kassa-pos-01
